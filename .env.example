# Server Port configuration
PORT=8081

# Internal Metrics and pprof profiler address
METRICS_ADDR=127.0.0.1:6060

# PostgreSQL connection URL (Docker container mapped on port 5435)
DATABASE_URL=postgres://postgres:postgrespassword@127.0.0.1:5435/1Million?sslmode=disable

# Redis connection URL
REDIS_URL=127.0.0.1:6379

# Redis write-through strategy: sync | async | off
REDIS_WRITETHROUGH=sync

# Pre-populate L1 in-memory table on startup (1 to enable for benchmark fixture, 0 for empty)
BENCH_FIXTURE=1

# Development flag: allow writes to succeed without active DB connection (0 in production)
ALLOW_NO_DB=0
